  "narrative": {
    "northStar": "The Sync Board",
    "overview": "This is the kurikulum work surface for SMK Grafika: a cool sheet, a timetable grid, and one Press Blue that marks both human action and machine output. Density is product-like (Operate), not marketing. Geist carries every role; nothing performs “schooly” or “AI futurism.”\n\nBlue is scarce on purpose. It appears on the primary control, the current selection, focus, and AI chrome. Conflict severity stays red and amber so a predicted clash is never mistaken for a brand flourish. Depth is tonal: Cool Sheet, a slightly grayer sidebar, a near-white card, a 1px ink-tinted ring. No rest-state drop shadows.\n\nRejected by the incumbent build and confirmed with the product owner: neon or glow “AI,” a second purple for intelligence, and hero-metric dashboards of big numbers.",
    "keyCharacteristics": [
      "One chromatic voice (Press Blue, hue 247) for action, selection, focus, and AI",
      "Cool Sheet neutrals, never warm cream",
      "Quiet tools: compact controls, familiar affordances, Indonesian task copy",
      "Tonal layering and hairline rings instead of elevation shadows",
      "Timetable grid is the signature, not a card gallery"
    ],
    "rules": [
      { "name": "The One Voice Rule", "body": "Press Blue is the only accent for action and AI. Do not introduce a second hue (purple, neon cyan) to mean “machine.”", "section": "colors" },
      { "name": "The Cool Sheet Rule", "body": "Neutrals stay on hue 247. Warm gray, cream, and ivory are out.", "section": "colors" },
      { "name": "The One Family Rule", "body": "Do not pair a display serif or a second geometric sans. Geist does titles, controls, and data.", "section": "typography" },
      { "name": "The Ring Not Shadow Rule", "body": "Surfaces are flat. A 1px ring (or Press Blue focus ring) is the depth system. Do not add rest-state drop shadows to look “premium.”", "section": "elevation" }
    ],
    "dos": [
      "Do use Press Blue for the one primary action on a screen, current selection, focus, and AI chrome.",
      "Do keep neutrals on hue 247 (Cool Sheet, sidebar, ink).",
      "Do separate conflict severity (danger/warning) from AI marking (Press Blue badge).",
      "Do set data times in tabular figures; keep prose near 65ch.",
      "Do label synthetic timetable data as dummy when a visitor could take it as SMK Grafika fact."
    ],
    "donts": [
      "Don't add a purple, neon, or glow layer to mean AI.",
      "Don't build dashboards from hero metrics (big number + label + sparkline).",
      "Don't drop-shadow cards at rest.",
      "Don't put a display serif or a second sans on product UI.",
      "Don't use a thick colored left bar on conflict or insight surfaces.",
      "Don't auto-apply an AI resolution in the interface; kurikulum applies it."
    ]
  }
